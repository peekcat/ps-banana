@echo off
set "CONFIGDIR=%~dp0"
powershell -ExecutionPolicy Bypass -Command "[Console]::OutputEncoding=[System.Text.Encoding]::UTF8; $Host.UI.RawUI.WindowTitle='Plugin Updater'; Write-Host ''; Write-Host '  ============================================' -ForegroundColor Cyan; Write-Host '    Wheelchair Plugin Auto-Updater' -ForegroundColor Cyan; Write-Host '  ============================================' -ForegroundColor Cyan; Write-Host ''; try { $c=Get-Content '%CONFIGDIR%update_config.json' -Raw -Encoding UTF8 | ConvertFrom-Json } catch { Write-Host '  [ABORT] Config not readable. Press Enter to close.' -ForegroundColor Red; Read-Host; exit 1 }; $z=$c.zipPath; $d=$c.pluginDir; if ([string]::IsNullOrWhiteSpace($d) -or [string]::IsNullOrWhiteSpace($z)) { Write-Host '  [ABORT] Config missing zipPath or pluginDir. Press Enter to close.' -ForegroundColor Red; Read-Host; exit 1 }; if (-not (Test-Path -LiteralPath (Join-Path $d 'manifest.json') -PathType Leaf)) { Write-Host ('  [ABORT] Plugin folder has no manifest.json - refusing to delete: '+$d) -ForegroundColor Red; Write-Host '  This safety check prevents accidentally wiping wrong directory.' -ForegroundColor Yellow; Write-Host '  Press Enter to close.' -ForegroundColor Yellow; Read-Host; exit 1 }; Write-Host '  Update package :' (Split-Path $z -Leaf) -ForegroundColor Yellow; Write-Host '  Plugin folder  :' $d -ForegroundColor Yellow; Write-Host ''; Write-Host '  [STEP 1/5] Waiting for Photoshop to close...' -ForegroundColor White; $w=$false; while(Get-Process -Name Photoshop -EA SilentlyContinue){ if(-not $w){Write-Host '           Please save your work and close Photoshop.' -ForegroundColor Red; $w=$true}; Start-Sleep 2}; Write-Host '           Photoshop closed.' -ForegroundColor Green; Write-Host ''; Write-Host '  [STEP 2/5] Backing up current version...' -ForegroundColor White; $bk=$d+'_backup'; if(Test-Path -LiteralPath $bk){Remove-Item -LiteralPath $bk -Recurse -Force -EA SilentlyContinue}; Copy-Item -LiteralPath $d -Destination $bk -Recurse -Force -EA SilentlyContinue; Write-Host '           Backup done.' -ForegroundColor Gray; Write-Host ''; Write-Host '  [STEP 3/5] Cleaning old files (keeping plugin folder)...' -ForegroundColor White; Get-ChildItem -LiteralPath $d -Force -EA SilentlyContinue | Remove-Item -Recurse -Force -EA SilentlyContinue; Write-Host '           Old files removed.' -ForegroundColor Gray; Write-Host ''; Write-Host '  [STEP 4/5] Installing (admin required, click YES)...' -ForegroundColor White; Start-Process powershell -Verb RunAs -ArgumentList ('-ExecutionPolicy Bypass -Command \"Expand-Archive -Force -Path '''+$z+''' -DestinationPath '''+$d+'''; Start-Sleep 1\"') -Wait; if(-not (Test-Path -LiteralPath (Join-Path $d 'manifest.json') -PathType Leaf)){ Write-Host '           ERROR: manifest.json missing after extract! Restoring backup...' -ForegroundColor Red; Get-ChildItem -LiteralPath $d -Force -EA SilentlyContinue | Remove-Item -Recurse -Force -EA SilentlyContinue; Copy-Item -LiteralPath ($bk+'\\*') -Destination $d -Recurse -Force -EA SilentlyContinue; Write-Host '           Restored. Please retry update.' -ForegroundColor Yellow; Write-Host ''; Write-Host '  Press Enter to close.' -ForegroundColor Gray; Read-Host; exit 1 }; Write-Host '           Files extracted.' -ForegroundColor Green; Write-Host ''; Write-Host '  [STEP 5/5] Update complete!' -ForegroundColor Green; Write-Host ''; Write-Host '  ============================================' -ForegroundColor Cyan; Write-Host '    Please open Photoshop to use new version.' -ForegroundColor White; Write-Host '  ============================================' -ForegroundColor Cyan; Write-Host ''; Write-Host '  Closing in 10 seconds...' -ForegroundColor Gray; Start-Sleep 10;"
