@echo off
setlocal
set "CONFIGDIR=%~dp0"
chcp 65001 >NUL
powershell -ExecutionPolicy Bypass -Command "[Console]::OutputEncoding=[System.Text.Encoding]::UTF8; $Host.UI.RawUI.WindowTitle='Satellite Installer'; Write-Host ''; Write-Host '  ============================================' -ForegroundColor Cyan; Write-Host '    Wheelchair Satellite Installer' -ForegroundColor Cyan; Write-Host '  ============================================' -ForegroundColor Cyan; Write-Host ''; $c = Get-Content '%CONFIGDIR%satellite_install_config.json' -Raw -Encoding UTF8 | ConvertFrom-Json; $z = $c.zipPath; $d = $c.targetDir; Write-Host '  Package    :' (Split-Path $z -Leaf) -ForegroundColor Yellow; Write-Host '  Install to :' $d -ForegroundColor Yellow; Write-Host ''; Write-Host '  [STEP 1/4] Waiting for Photoshop to close...' -ForegroundColor White; $w = $false; while (Get-Process -Name Photoshop -EA SilentlyContinue) { if (-not $w) { Write-Host '           Please close Photoshop to continue.' -ForegroundColor Red; $w = $true }; Start-Sleep 2 }; Write-Host '           Photoshop closed.' -ForegroundColor Green; Write-Host ''; Write-Host '  [STEP 2/4] Preparing target folder...' -ForegroundColor White; $parent = Split-Path $d -Parent; if (-not (Test-Path $parent)) { Write-Host '           ERROR: Plugins folder not found:' $parent -ForegroundColor Red; Write-Host '           Photoshop may not be installed at expected path.' -ForegroundColor Red; Write-Host '  Closing in 30 seconds...' -ForegroundColor Gray; Start-Sleep 30; exit 1 }; if (Test-Path $d) { Write-Host '           Found existing satellite folder, will replace.' -ForegroundColor Gray } else { Write-Host '           Will create new satellite folder.' -ForegroundColor Gray }; Write-Host ''; Write-Host '  [STEP 3/4] Installing (admin required, click YES on UAC)...' -ForegroundColor White; $cmd = 'if (Test-Path ''' + $d + ''') { Remove-Item ''' + $d + ''' -Recurse -Force }; Expand-Archive -Force -Path ''' + $z + ''' -DestinationPath ''' + $d + ''';'; try { Start-Process powershell -Verb RunAs -ArgumentList ('-ExecutionPolicy Bypass -Command \"' + $cmd + '\"') -Wait } catch { Write-Host '           ERROR: User declined UAC or elevation failed.' -ForegroundColor Red; Write-Host '  Closing in 30 seconds...' -ForegroundColor Gray; Start-Sleep 30; exit 1 }; if (-not (Test-Path (Join-Path $d 'manifest.json'))) { Write-Host '           ERROR: Install failed (manifest.json missing).' -ForegroundColor Red; Write-Host '  Closing in 30 seconds...' -ForegroundColor Gray; Start-Sleep 30; exit 1 }; Write-Host '           Files extracted.' -ForegroundColor Green; Write-Host ''; Write-Host '  [STEP 4/4] Done!' -ForegroundColor Green; Write-Host ''; Write-Host '  ============================================' -ForegroundColor Cyan; Write-Host '    Open Photoshop, find satellite in Plug-ins menu.' -ForegroundColor White; Write-Host '  ============================================' -ForegroundColor Cyan; Write-Host ''; Write-Host '  Closing in 8 seconds...' -ForegroundColor Gray; Start-Sleep 8;"
